# Core
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="https://www.electrohypex.com"

# Admin auth (seed / credentials provider)
ADMIN_EMAIL="admin@electrohypex.com"
ADMIN_PASSWORD="changeme"

# Stripe — REQUIRED for launch (use sk_live_ / pk_live_ in production)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email — REQUIRED for launch (order confirmation + admin notify)
RESEND_API_KEY="re_..."
# Must use a domain verified in your Resend account (currently vitamiro.com)
EMAIL_FROM="ElectroHypeX <noreply@vitamiro.com>"
# Communication Engine — store default BCP 47 (customer.locale overrides)
COMMUNICATION_DEFAULT_LOCALE="nb-NO"

# Legal / trust (shown in storefront + email footers)
ORG_NUMBER=""
COMPANY_ADDRESS=""
NEXT_PUBLIC_SITE_URL="https://www.electrohypex.com"

# Internal workers (abandoned cart, cron, buyer hunt tick)
INTERNAL_CRON_TOKEN="long-random-token"
# Buyer Hunt Worker: prefer `npm run worker:buyer-hunt` (continuous).
# Serverless fallback: Inngest every minute + POST /api/internal/buyer-worker

# OpenAI — product AI enrichment / categorization
OPENAI_API_KEY=""

# Multi-supplier catalog (CJ first)
# Get key: cjdropshipping.com → My CJ → Authorization → API
CJ_API_KEY=""
# Optional override (default: https://developers.cjdropshipping.com/api2.0/v1)
# CJ_API_BASE_URL=""
# CJ_API_RATE_LIMIT=8

# Dropshipping fulfillment adapter (orders) — separate from catalog engine
# DROPSHIPPING_MODE=email
# DROPSHIPPING_SUPPLIER=cj

# Optional analytics / ads (only loads after cookie consent = all)
# Prefer GTM as hub: set GTM and configure GA/Meta/TikTok inside GTM.
# Leave direct pixel IDs empty if tags are managed in GTM (avoids double-counting).
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
NEXT_PUBLIC_CLARITY_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# Server-side conversions (Meta CAPI + GA4 Measurement Protocol)
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""

# Admin: show Next.js/React error overlay in development (default: hidden)
# NEXT_PUBLIC_DEBUG=true

# Dev DB metrics (query counts in server logs) — on by default in development
# DB_QUERY_METRICS=1

# Skip Prisma $connect() on boot (useful when Neon is quota-blocked)
# PRISMA_SKIP_CONNECT=1

# Local Postgres (preferred for daily admin polling) — see docs/local-database.md
# DATABASE_URL="postgresql://electrohype:electrohype@localhost:5432/electrohype?schema=public"

# Optional / future payment methods (not wired for launch)
# KLARNA_API_KEY=
# VIPPS_CLIENT_ID=
# VIPPS_CLIENT_SECRET=
# VIPPS_SUBSCRIPTION_KEY=
# VIPPS_MERCHANT_SERIAL_NUMBER=
